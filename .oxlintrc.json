{
  "$schema": "./node_modules/@effect/tsgo/oxlint-schema.json",
  "extends": [
    "./node_modules/@effect/tsgo/oxlint-presets/recommended.json"
  ],
  "plugins": [
    "typescript",
    "unicorn",
    "oxc",
    "react",
    "import"
  ],
  "jsPlugins": [
    {
      "name": "anti-slop",
      "specifier": "./tools/oxlint/anti-slop/index.ts"
    },
    {
      "name": "effect",
      "specifier": "./tools/oxlint/effect/index.ts"
    },
    {
      "name": "core",
      "specifier": "./tools/oxlint/core/index.ts"
    }
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "react/react-in-jsx-scope": "off",
    "unicorn/consistent-function-scoping": "off",
    "eslint/no-underscore-dangle": "off",
    "import/no-unassigned-import": "off",
    "anti-slop/no-chained-type-assertions": "error",
    "anti-slop/no-conditional-empty-object-spread": "error",
    "anti-slop/no-known-value-widening": "error",
    "anti-slop/no-module-mocking": "error",
    "anti-slop/no-object-parameters": "error",
    "anti-slop/no-reflect-apply": "error",
    "anti-slop/no-reflect-get": "error",
    "anti-slop/no-runtime-typeof": "error",
    "anti-slop/no-shape-in-symbol-names": "error",
    "anti-slop/no-unknown-parameters": "error",
    "anti-slop/no-unknown-returns": "error",
    "anti-slop/no-unknown-type-aliases": "error",
    "anti-slop/no-unsafe-dictionary-type": "error",
    "anti-slop/no-widen-then-assert": "error",
    "anti-slop/require-safety-comment-for-type-assertion": "error"
  },
  "overrides": [
    {
      "files": [
        "apps/**"
      ],
      "rules": {
        "effecttsgo/abort-controller-in-effect": "off",
        "effecttsgo/acquire-release-disposable": "off",
        "effecttsgo/all-of-map-to-for-each": "off",
        "effecttsgo/async-function": "off",
        "effecttsgo/catch-all-to-map-error": "off",
        "effecttsgo/catch-chain-to-first-success-of": "off",
        "effecttsgo/catch-conditional-refail-to-catch-if": "off",
        "effecttsgo/catch-die-to-or-die": "off",
        "effecttsgo/catch-tag-to-catch-reason": "off",
        "effecttsgo/catch-to-ignore": "off",
        "effecttsgo/catch-to-or-else-succeed": "off",
        "effecttsgo/catch-unfailable-effect": "off",
        "effecttsgo/class-self-mismatch": "off",
        "effecttsgo/crypto-random-uuid": "off",
        "effecttsgo/crypto-random-uuid-in-effect": "off",
        "effecttsgo/duplicate-package": "off",
        "effecttsgo/effect-fn-iife": "off",
        "effecttsgo/effect-fn-implicit-any": "off",
        "effecttsgo/effect-fn-opportunity": "off",
        "effecttsgo/effect-gen-uses-adapter": "off",
        "effecttsgo/effect-in-failure": "off",
        "effecttsgo/effect-in-void-success": "off",
        "effecttsgo/effect-map-flatten": "off",
        "effecttsgo/effect-map-void": "off",
        "effecttsgo/effect-succeed-with-void": "off",
        "effecttsgo/extends-native-error": "off",
        "effecttsgo/flat-map-to-map": "off",
        "effecttsgo/floating-effect": "off",
        "effecttsgo/floating-effect-in-vitest": "off",
        "effecttsgo/generic-effect-services": "off",
        "effecttsgo/global-console": "off",
        "effecttsgo/global-console-in-effect": "off",
        "effecttsgo/global-date": "off",
        "effecttsgo/global-date-in-effect": "off",
        "effecttsgo/global-error-in-effect-catch": "off",
        "effecttsgo/global-error-in-effect-failure": "off",
        "effecttsgo/global-fetch": "off",
        "effecttsgo/global-fetch-in-effect": "off",
        "effecttsgo/global-random": "off",
        "effecttsgo/global-random-in-effect": "off",
        "effecttsgo/global-timers": "off",
        "effecttsgo/global-timers-in-effect": "off",
        "effecttsgo/instance-of-schema": "off",
        "effecttsgo/layer-merge-all-with-dependencies": "off",
        "effecttsgo/lazy-effect": "off",
        "effecttsgo/lazy-promise-in-effect-sync": "off",
        "effecttsgo/leaking-requirements": "off",
        "effecttsgo/map-some-to-as-some": "off",
        "effecttsgo/missing-effect-context": "off",
        "effecttsgo/missing-effect-error": "off",
        "effecttsgo/missing-layer-context": "off",
        "effecttsgo/missing-return-yield-star": "off",
        "effecttsgo/missing-star-in-yield-effect-gen": "off",
        "effecttsgo/multiple-catch-tag": "off",
        "effecttsgo/multiple-effect-provide": "off",
        "effecttsgo/new-promise": "off",
        "effecttsgo/node-builtin-import": "off",
        "effecttsgo/non-object-effect-service-type": "off",
        "effecttsgo/option-match-to-from-option": "off",
        "effecttsgo/outdated-api": "off",
        "effecttsgo/overridden-schema-constructor": "off",
        "effecttsgo/prefer-schema-over-json": "off",
        "effecttsgo/prefer-succeed-some-or-none": "off",
        "effecttsgo/prefer-typed-schema-decoder": "off",
        "effecttsgo/prefer-unsafe-constructor": "off",
        "effecttsgo/process-env": "off",
        "effecttsgo/process-env-in-effect": "off",
        "effecttsgo/promise-in-effect-success": "off",
        "effecttsgo/redundant-map-error": "off",
        "effecttsgo/redundant-or-die": "off",
        "effecttsgo/redundant-schema-tag-identifier": "off",
        "effecttsgo/return-effect-in-gen": "off",
        "effecttsgo/run-effect-inside-effect": "off",
        "effecttsgo/schema-literal-non-finite": "off",
        "effecttsgo/schema-number": "off",
        "effecttsgo/schema-opaque-instance-member": "off",
        "effecttsgo/schema-struct-with-tag": "off",
        "effecttsgo/schema-sync-in-effect": "off",
        "effecttsgo/scope-in-layer-effect": "off",
        "effecttsgo/sync-to-succeed": "off",
        "effecttsgo/try-catch-in-effect-gen": "off",
        "effecttsgo/unknown-in-effect-catch": "off",
        "effecttsgo/unnecessary-effect-gen": "off",
        "effecttsgo/unnecessary-fail-yieldable-error": "off",
        "effecttsgo/unnecessary-pipe": "off",
        "effecttsgo/unnecessary-pipe-chain": "off",
        "effecttsgo/unnecessary-typeof-type": "off",
        "effecttsgo/unsafe-effect-type-assertion": "off",
        "react/immutability": "off",
        "react/no-unstable-nested-components": "off"
      }
    },
    {
      "files": [
        "api/**",
        "packages/domain/**",
        "packages/contracts/**"
      ],
      "rules": {
        "effect/no-ambient-nondeterminism": "error",
        "effect/no-cascading-layer-provide": "warn",
        "effect/no-disable-validation": "error",
        "effect/no-effect-asvoid": "warn",
        "effect/no-global-json": "error",
        "effect/no-in-operator": "error",
        "effect/no-nested-effect-array-methods": "error",
        "effect/no-nested-layer-provide": "warn",
        "effect/no-service-option": "error",
        "effect/no-shadowed-standard-array-static": "error",
        "effect/no-silent-error-swallow": "error",
        "effect/no-static-effect-service-forwarders": "error",
        "effect/no-switch": "error",
        "effect/no-try-catch": "error",
        "effect/no-typeof-object": "error",
        "effect/pipe-max-arguments": "warn",
        "effect/prefer-effect-match": "error",
        "effect/prefer-option-from-nullable": "warn",
        "effect/require-context-service-in-services": "error"
      }
    },
    {
      "files": [
        "api/**",
        "packages/domain/**",
        "packages/contracts/**"
      ],
      "rules": {
        "core/no-single-use-private-functions": "error",
        "core/private-function-prefix": "error"
      }
    }
  ],
  "ignorePatterns": [
    "dist",
    "node_modules",
    "out",
    ".astro",
    "tools/oxlint",
    ".agents"
  ]
}